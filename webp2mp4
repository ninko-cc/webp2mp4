#!/bin/bash
set -u

if [[ $# -ne 1 ]]; then
  echo "Usage: webp2mp4 [FILE]" >&2
  exit 1
fi

INPUT_FILE=$1

if [[ ! -f "$INPUT_FILE" ]]; then
  echo "Error: $INPUT_FILE not found" >&2
  exit 1
fi

OUTPUT_FILE="${INPUT_FILE%.*}".mp4

TEMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TEMP_DIR"' EXIT

FPS=`webpmux -info "$INPUT_FILE" | awk '/^ *[0-9]+:/ { n++; total += $7 } END { printf "%.3f", n * 1000 / total }'`

mkdir -p $TEMP_DIR
anim_dump -folder $TEMP_DIR -prefix frame_ "$INPUT_FILE"

echo "Encoding file: $TEMP_DIR/frame_xxxx.png as $OUTPUT_FILE"

ffmpeg -v error \
  -framerate $FPS \
  -i $TEMP_DIR/frame_%04d.png \
  -vf "scale=trunc(iw/2)*2:trunc(ih/2)*2" \
  -pix_fmt yuv420p \
  -movflags faststart \
  "$OUTPUT_FILE"
